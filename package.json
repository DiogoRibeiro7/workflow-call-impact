{
  "name": "workflow-call-impact",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=cjs --minify --outfile=dist/index.cjs",
    "check": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts' package.json tsconfig.json",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts' package.json tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "check:dist": "npm run build && git diff --exit-code -- dist/index.cjs"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "esbuild": "0.28.2",
    "prettier": "3.6.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
